#!/usr/bin/env bash
# fsla-devtools' commit gate, in the tree: `core.hooksPath` points a checkout here (per worktree). It runs
# `bazel test //:gate` on the commit as git will write it (`fsla_devtools.graph.front_door`'s `commit_gate`, every FSLA
# repository's), through this workspace's front door.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
#: the mirror's content checks over the staged diff first (fsla_devtools.tripwire): a refusal names the line and the check
PYTHONPATH="$root" python3 -m fsla_devtools.tripwire --staged
exec "$root/bazel/bazel" --commit-gate

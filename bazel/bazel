#!/usr/bin/env python3
"""fsla-devtools' front door: bazelisk runs this file (the wrapper `.bazeliskrc` names) in place of the Bazel it
downloaded, and it runs this checkout's own front door (`fsla_devtools.graph.front_door`) for this workspace."""
from __future__ import annotations

import sys
from pathlib import Path

sys.dont_write_bytecode = True  # the front door runs from the checkout: it leaves no bytecode there
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from fsla_devtools.graph import front_door  # noqa: E402 -- the path insert above must precede it

if __name__ == "__main__":
    sys.exit(front_door.main(sys.argv[1:], ROOT))
